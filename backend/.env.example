# Copy this file to .env and fill in real values. NEVER commit .env.
#   cp .env.example .env
# The server reads normal environment variables, so load the file first:
#   set -a && source .env && set +a && go run ./cmd/server

# Where the dashboard gets its data: "mock" (default) or "expa".
DATA_SOURCE=mock

# EXPA access token. Only needed when DATA_SOURCE=expa.
# Server-side only: it is never sent to the browser.
EXPA_ACCESS_TOKEN=your-expa-access-token-here

# Port for the local server (Vercel sets this itself).
PORT=8080
